rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return isSignedIn()
        && currentUserDoc().data.status == 'active';
    }

    function isAdmin() {
      return isActive()
        && currentUserDoc().data.role == 'admin';
    }

    function isOwnUserDoc(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Permission-map lookup (TDD §12/§40) — the authorization boundary for
    // every collection below the `users` collection itself.
    function hasPermission(perm) {
      return isActive() && currentUserDoc().data.permissions[perm] == true;
    }

    // Fields only an admin may set/change on a user document.
    function adminOnlyFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.permissions == resource.data.permissions;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isOwnUserDoc(userId) && isActive());

      // Admins manage any user document.
      allow write: if isAdmin();

      // A user may update their own profile fields (e.g. displayName) but
      // can never grant themselves a role, status, or permission.
      allow update: if isOwnUserDoc(userId) && isActive() && adminOnlyFieldsUnchanged();
    }

    match /customers/{customerId} {
      allow read: if hasPermission('customer.read');
      allow create: if hasPermission('customer.create')
        && request.resource.data.createdBy == request.auth.uid;
      // Edit/delete come with a later phase (contract linkage, audit trail);
      // customers are create+read only for now.
      allow update, delete: if false;
    }

    match /properties/{propertyId} {
      allow read: if hasPermission('property.read');
      allow create: if hasPermission('property.create')
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /contractTemplates/{templateId} {
      allow read: if hasPermission('template.read');
      // A template is always created with currentVersion == 1 (its first
      // version is written in the same batch by the client — see
      // FirestoreTemplateRepository.createTemplate).
      allow create: if hasPermission('template.create')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.currentVersion == 1;
      // template.edit may change metadata (name/code/status) but must never
      // touch currentVersion; only template.publish may bump it, and only by
      // exactly 1 (TDD §15: "a new template version is created instead of
      // modifying a published version").
      allow update: if (hasPermission('template.edit')
                          && request.resource.data.currentVersion == resource.data.currentVersion)
                      || (hasPermission('template.publish')
                          && request.resource.data.currentVersion == resource.data.currentVersion + 1);
      allow delete: if false;
    }

    match /contractTemplateVersions/{versionId} {
      allow read: if hasPermission('template.read');
      // version == 1 is the template's own first version, written alongside
      // it under template.create; version > 1 is a later revision, which
      // requires template.publish instead.
      allow create: if request.resource.data.createdBy == request.auth.uid
        && ((request.resource.data.version == 1 && hasPermission('template.create'))
            || (request.resource.data.version > 1 && hasPermission('template.publish')));
      // Immutable once created (TDD §15/§16) — no update or delete, ever.
      allow update, delete: if false;
    }

    match /contracts/{contractId} {
      allow read: if hasPermission('contract.read');
      // Every contract is born a Draft with a fresh server-assigned number
      // (TDD §39) — version pinned to 1, exactly like a template's v1.
      allow create: if hasPermission('contract.create')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.version == 1;

      // Fields that must never change across ANY update, whoever performs it.
      function contractCoreFieldsUnchanged() {
        return request.resource.data.contractNumber == resource.data.contractNumber
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.version == resource.data.version
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.propertyId == resource.data.propertyId
          && request.resource.data.templateId == resource.data.templateId
          && request.resource.data.templateVersion == resource.data.templateVersion;
      }

      // Owner editing clause content (or sourceQuotationId) on their own Draft.
      function isOwnerEditingDraft() {
        return hasPermission('contract.edit_own')
          && resource.data.createdBy == request.auth.uid
          && resource.data.status == 'DRAFT'
          && request.resource.data.status == 'DRAFT';
      }

      // Owner submitting their own Draft for approval (TDD §23 Submit).
      function isOwnerSubmitting() {
        return hasPermission('contract.submit')
          && resource.data.createdBy == request.auth.uid
          && resource.data.status == 'DRAFT'
          && request.resource.data.status == 'PENDING_APPROVAL';
      }

      // Admin approving a pending contract (TDD §23 Approve).
      function isAdminApproving() {
        return hasPermission('contract.approve')
          && resource.data.status == 'PENDING_APPROVAL'
          && request.resource.data.status == 'APPROVED'
          && request.resource.data.approvedBy == request.auth.uid;
      }

      // Admin rejecting a pending contract (TDD §23/§24 Reject).
      function isAdminRejecting() {
        return hasPermission('contract.reject')
          && resource.data.status == 'PENDING_APPROVAL'
          && request.resource.data.status == 'REJECTED'
          && request.resource.data.rejection.rejectedBy == request.auth.uid;
      }

      // Owner moving their own Rejected contract back to Draft to revise it.
      function isOwnerRevising() {
        return hasPermission('contract.edit_own')
          && resource.data.createdBy == request.auth.uid
          && resource.data.status == 'REJECTED'
          && request.resource.data.status == 'DRAFT';
      }

      allow update: if contractCoreFieldsUnchanged()
        && (isOwnerEditingDraft()
            || isOwnerSubmitting()
            || isAdminApproving()
            || isAdminRejecting()
            || isOwnerRevising());

      allow delete: if false;
    }

    // Business-significant contract transitions (TDD §31) — every contracts/
    // write above adds exactly one of these in the same transaction. Only
    // readable by admins; a client can add an entry (its own actorId only)
    // but can never edit or remove one once written.
    match /auditLogs/{logId} {
      allow read: if hasPermission('audit.read');
      allow create: if isActive() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // The pre-existing quotation calculator (unrelated to the Contract
    // System's RBAC) — every active signed-in user can read/create, and may
    // delete only their own. Never edited in place once created.
    match /quotations/{quotationId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isActive() && resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }

    // Logical per-year counters (TDD §39) — never read by the client, only
    // advanced by exactly 1 inside a transaction (FirestoreContractRepository
    // for contracts_YYYY, FirestoreQuotationRepository for quotations_YYYY).
    // Gating differs by which counter it is: contract numbering needs
    // contract.create, quotation numbering only needs an active account,
    // matching the collections they back.
    match /counters/{counterId} {
      allow read: if false;
      allow create: if request.resource.data.count == 1 && (
        (counterId.matches('contracts_.*') && hasPermission('contract.create')) ||
        (counterId.matches('quotations_.*') && isActive())
      );
      allow update: if request.resource.data.count == resource.data.count + 1 && (
        (counterId.matches('contracts_.*') && hasPermission('contract.create')) ||
        (counterId.matches('quotations_.*') && isActive())
      );
      allow delete: if false;
    }

    // Everything else is deferred to later phases (finalization, invoice
    // linking, ...) and denied by default until those rules are added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
