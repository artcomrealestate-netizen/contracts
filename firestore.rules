rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return isSignedIn()
        && currentUserDoc().data.status == 'active';
    }

    function isAdmin() {
      return isActive()
        && currentUserDoc().data.role == 'admin';
    }

    function isOwnUserDoc(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Permission-map lookup (TDD §12/§40) — the authorization boundary for
    // every collection below the `users` collection itself.
    function hasPermission(perm) {
      return isActive() && currentUserDoc().data.permissions[perm] == true;
    }

    // Fields only an admin may set/change on a user document.
    function adminOnlyFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.permissions == resource.data.permissions;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isOwnUserDoc(userId) && isActive());

      // Admins manage any user document.
      allow write: if isAdmin();

      // A user may update their own profile fields (e.g. displayName) but
      // can never grant themselves a role, status, or permission.
      allow update: if isOwnUserDoc(userId) && isActive() && adminOnlyFieldsUnchanged();
    }

    match /customers/{customerId} {
      allow read: if hasPermission('customer.read');
      allow create: if hasPermission('customer.create')
        && request.resource.data.createdBy == request.auth.uid;
      // customer.update (not in TDD §12 — see permission.dart) may change
      // every field except who created it; not creator-restricted, since a
      // customer record is a shared company record, not personal to whoever
      // first entered it.
      allow update: if hasPermission('customer.update')
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    match /properties/{propertyId} {
      allow read: if hasPermission('property.read');
      allow create: if hasPermission('property.create')
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasPermission('property.update')
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    match /contractTemplates/{templateId} {
      allow read: if hasPermission('template.read');
      // A template is always created with currentVersion == 1 (its first
      // version is written in the same batch by the client — see
      // FirestoreTemplateRepository.createTemplate).
      allow create: if hasPermission('template.create')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.currentVersion == 1;
      // template.edit may change metadata (name/code/status) but must never
      // touch currentVersion; only template.publish may bump it, and only by
      // exactly 1 (TDD §15: "a new template version is created instead of
      // modifying a published version").
      allow update: if (hasPermission('template.edit')
                          && request.resource.data.currentVersion == resource.data.currentVersion)
                      || (hasPermission('template.publish')
                          && request.resource.data.currentVersion == resource.data.currentVersion + 1);
      allow delete: if false;
    }

    match /contractTemplateVersions/{versionId} {
      allow read: if hasPermission('template.read');
      // version == 1 is the template's own first version, written alongside
      // it under template.create; version > 1 is a later revision, which
      // requires template.publish instead.
      allow create: if request.resource.data.createdBy == request.auth.uid
        && ((request.resource.data.version == 1 && hasPermission('template.create'))
            || (request.resource.data.version > 1 && hasPermission('template.publish')));
      // Immutable once created (TDD §15/§16) — no update or delete, ever.
      allow update, delete: if false;
    }

    match /contracts/{contractId} {
      // contract.edit_any doubles as the "admin-level, sees everything" scope
      // here, not just an editing one — an employee with only contract.read
      // can read their own contracts (a get() by id, or a list() query the
      // client must filter by createdBy == uid to satisfy this same check —
      // see FirestoreContractRepository.watchContracts).
      allow read: if hasPermission('contract.read')
        && (hasPermission('contract.edit_any') || resource.data.createdBy == request.auth.uid);
      // Every contract is born a Draft with a fresh server-assigned number
      // (TDD §39) — version pinned to 1, exactly like a template's v1.
      allow create: if hasPermission('contract.create')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.version == 1;

      // Fields that must never change across ANY update, whoever performs it.
      // contractNumber/createdBy/version/templateId/templateVersion never
      // change no matter which transition this is. customerId/propertyId
      // are handled separately below — they're allowed to change, but only
      // while the owner is editing their own Draft.
      function immutableIdentityFieldsUnchanged() {
        return request.resource.data.contractNumber == resource.data.contractNumber
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.version == resource.data.version
          && request.resource.data.templateId == resource.data.templateId
          && request.resource.data.templateVersion == resource.data.templateVersion;
      }

      // Owner editing clause content, sourceQuotationId, customerId, or
      // propertyId on their own Draft.
      function isOwnerEditingDraft() {
        return hasPermission('contract.edit_own')
          && resource.data.createdBy == request.auth.uid
          && resource.data.status == 'DRAFT'
          && request.resource.data.status == 'DRAFT';
      }

      // Every transition other than isOwnerEditingDraft() must leave
      // customerId/propertyId exactly as they were — changing which
      // customer/property a contract is for only makes sense while it's
      // still an editable Draft.
      function customerAndPropertyUnchangedUnlessEditingDraft() {
        return isOwnerEditingDraft()
          || (request.resource.data.customerId == resource.data.customerId
              && request.resource.data.propertyId == resource.data.propertyId);
      }

      // Owner submitting their own Draft for approval (TDD §23 Submit).
      function isOwnerSubmitting() {
        return hasPermission('contract.submit')
          && resource.data.createdBy == request.auth.uid
          && resource.data.status == 'DRAFT'
          && request.resource.data.status == 'PENDING_APPROVAL';
      }

      // Admin approving a pending contract (TDD §23 Approve).
      function isAdminApproving() {
        return hasPermission('contract.approve')
          && resource.data.status == 'PENDING_APPROVAL'
          && request.resource.data.status == 'APPROVED'
          && request.resource.data.approvedBy == request.auth.uid;
      }

      // Admin rejecting a pending contract (TDD §23/§24 Reject).
      function isAdminRejecting() {
        return hasPermission('contract.reject')
          && resource.data.status == 'PENDING_APPROVAL'
          && request.resource.data.status == 'REJECTED'
          && request.resource.data.rejection.rejectedBy == request.auth.uid;
      }

      // Owner moving their own Rejected contract back to Draft to revise it.
      function isOwnerRevising() {
        return hasPermission('contract.edit_own')
          && resource.data.createdBy == request.auth.uid
          && resource.data.status == 'REJECTED'
          && request.resource.data.status == 'DRAFT';
      }

      // Finalizing an approved contract (TDD §22/§23/§27) — content becomes
      // immutable from here: no branch of this same allow-update lets
      // anything through once status == 'FINALIZED' (every branch requires
      // a specific status to move FROM, and none of them is FINALIZED).
      function isFinalizing() {
        return hasPermission('contract.finalize')
          && resource.data.status == 'APPROVED'
          && request.resource.data.status == 'FINALIZED'
          && request.resource.data.finalizedBy == request.auth.uid;
      }

      allow update: if immutableIdentityFieldsUnchanged()
        && customerAndPropertyUnchangedUnlessEditingDraft()
        && (isOwnerEditingDraft()
            || isOwnerSubmitting()
            || isAdminApproving()
            || isAdminRejecting()
            || isOwnerRevising()
            || isFinalizing());

      allow delete: if false;
    }

    // Business-significant contract transitions (TDD §31) — every contracts/
    // write above adds exactly one of these in the same transaction. Only
    // readable by admins; a client can add an entry (its own actorId only)
    // but can never edit or remove one once written.
    match /auditLogs/{logId} {
      allow read: if hasPermission('audit.read');
      allow create: if isActive() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // The pre-existing quotation calculator (unrelated to the Contract
    // System's RBAC) — every active signed-in user can read/create, and may
    // delete only their own. Never edited in place once created.
    match /quotations/{quotationId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isActive() && resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }

    // Logical per-year counters (TDD §39) — never read by the client, only
    // advanced by exactly 1 inside a transaction (FirestoreContractRepository
    // for contracts_YYYY, FirestoreQuotationRepository for quotations_YYYY).
    // Gating differs by which counter it is: contract numbering needs
    // contract.create, quotation numbering only needs an active account,
    // matching the collections they back.
    match /counters/{counterId} {
      // Simplified from an earlier version that branched on
      // counterId.matches('contracts_.*'/'quotations_.*') combined with
      // hasPermission('contract.create') — that combination reliably threw
      // an unconverted native error client-side on Web (cloud_firestore
      // 6.9.0 / cloud_firestore_web 5.7.3) for reasons not fully isolated
      // (possibly the regex-guarded get() calls inside a transaction).
      // Counters carry no sensitive data on their own — actual contract/
      // quotation creation is still separately gated by those collections'
      // own strict create rules — so the extra contract.create-only
      // narrowing wasn't worth the fragility.
      //
      // isActive() itself was then also found to be the problem: it calls
      // get() on the caller's own /users/{uid} doc, and evaluating that
      // inside a transaction's write (see FirestoreContractRepository /
      // FirestoreQuotationRepository numbering transactions) reliably threw
      // the same unconverted native error client-side on Web. isSignedIn()
      // needs no extra get(), so it doesn't hit that path — an inactive/
      // suspended account could still burn a counter value this way, but
      // counters carry no data of their own, so that's a cosmetic gap
      // (a skipped number), not a security one.
      //
      // The numbering code itself was then changed to write with
      // FieldValue.increment(1) instead of inside a transaction (runTransaction()
      // turned out to be the actual root cause — every transaction on this
      // setup reliably threw the same unconverted native error regardless of
      // what the rules said). That code also needs to read the value back
      // after incrementing it (a transaction's own .get() doesn't apply once
      // it's a plain write) — read was still `if false` at that point, which
      // is what was actually causing the next round of permission-denied
      // errors (a client-code bug, not a rules-content one this time). Value
      // checks on write (count == 1 / count == resource.data.count + 1) were
      // also dropped in the same pass — untested in isolation once read was
      // still broken — leaving both read and write on isSignedIn() alone. A
      // client could in principle set count to any value, but this
      // collection carries nothing sensitive either way.
      allow read: if isSignedIn();
      allow write: if isSignedIn();
      allow delete: if false;
    }

    // Everything else is deferred to later phases (finalization, invoice
    // linking, ...) and denied by default until those rules are added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
