# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
/android/app/build/

# iOS signing secrets - never commit these; CI recreates them from GitHub Secrets.
# (Android keystore/key.properties are already ignored in android/.gitignore.)
ios/Runner.xcarchive
ios/certs/
ios/ExportOptions.plist

# Signing secrets and keystores, wherever they end up (belt-and-suspenders on
# top of android/.gitignore, since a copy of the keystore also lives at repo root).
*.jks
*.keystore
*.p12
*.pem
keystore.b64
key.properties

# Environment variables / local secrets
.env
.env.*

# Claude Code
.claude/

# Firebase CLI local cache
.firebase/
